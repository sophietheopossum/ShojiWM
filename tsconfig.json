{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "shoji_wm",
    "strict": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "shoji_wm": [
        "./packages/shoji_wm/src/index.ts"
      ],
      "shoji_wm/*": [
        "./packages/shoji_wm/src/*"
      ]
    }
  },
  "exclude": ["node_modules", "target", "docs", "tests/*.test.ts", "tests/node-test.d.ts"]
}
